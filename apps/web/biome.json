{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["app/**", "components/**", "next.config.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  }
}
